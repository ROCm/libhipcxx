# rocm-docs-core external-ToC source template. Variable substitution
# (${branch}, ${url}, ${project:<name>}) is performed by rocm-docs-core
# at build time and the result is written to .sphinx/_toc.yml, which
# sphinx-external-toc then consumes.
#
# This ToC drives the sidebar / breadcrumb navigation of the rendered
# documentation. The per-page toctree:: directives inside individual
# .rst files continue to drive in-page section navigation, but the
# top-level navigation here takes precedence.
#
# NOTE(HIP/AMD): the API reference pages still live in the on-disk
# subdirectory ``docs/libcudacxx/`` (not ``docs/libhipcxx/``) on purpose
# -- it mirrors upstream NVIDIA cccl's docs layout so that future
# cherry-picks of upstream docs changes apply with minimal friction. The
# textual ``libcu++``/``libcudacxx`` -> ``libhipcxx`` rebrand is only
# inside the file contents; the path is kept.
#
# Do NOT declare the children of ``libcudacxx/standard_api``,
# ``libcudacxx/extended_api``, or ``libcudacxx/ptx`` here. Each of those
# pages already carries a ``:hidden:`` ``toctree::`` directive that
# enumerates its own children; declaring them in BOTH places renders
# every link twice in the rocm-docs-core sidebar (sphinx-external-toc
# contributes via _toc.yml, AND the rst ``toctree::`` directive
# contributes independently via sphinx's native ToC).
defaults:
  numbered: False
  maxdepth: 6
root: index
subtrees:
  - caption: Install
    entries:
      - file: install/install
        title: Install libhipcxx
      - file: install/source-build
        title: Build from source

  - caption: Conceptual
    entries:
      - file: conceptual/libhipcxx-standard-library-features
        title: C++ Standard Library features
      - file: conceptual/libhipcxx-extensions
        title: C++ Standard Library extensions
      - file: conceptual/libhipcxx-hip-abstractions
        title: HIP-specific abstractions and namespaces

  - caption: How to
    entries:
      - file: how-to/use-libhipcxx-in-a-project
        title: Add libhipcxx to a CMake project
      - file: how-to/run-libhipcxx-tests
        title: Run the libhipcxx tests

  - caption: API reference
    entries:
      - file: libcudacxx/standard_api
        title: Standard API
      - file: libcudacxx/extended_api
        title: Extended API
      - file: libcudacxx/ptx
        title: PTX API
      - file: reference/libhipcxx-limitations
        title: Limitations and unsupported APIs
      - file: reference/libhipcxx-conformance
        title: Conformance and ABI evolution
      - file: libcudacxx/releases
        title: Releases

  - caption: About
    entries:
      - file: libcudacxx/contributing
        title: Contributing
      - file: license
        title: License
