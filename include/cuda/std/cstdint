#if !_CCCL_COMPILER(NVRTC) && !defined(_CCCL_COMPILER_HIPRTC)
#  include <cstdint>
#else // ^^^ !_CCCL_COMPILER(NVRTC) ^^^ / vvv _CCCL_COMPILER(NVRTC) vvv
#  include <cuda/std/climits>

// NOTE(HIP/AMD): Under HIPRTC with -nostdinc++ (e.g., cudf JIT), the host C++
// standard library is not on the include path, so <cstdint> is not found.
// However, when HIPRTC is used WITHOUT -nostdinc++ (e.g., lit tests), the system
// <cstdint> IS available and should be used to avoid redefinition errors.
//
// Strategy: Check if <cstdint> is available. If yes, use it; if no (nostdinc++),
// provide our own fixed-width integer type definitions.
//
// NOTE(HIP/AMD): Under HIPRTC the fixed-width integer types must match HIP's
// device types (<hip/amd_detail/host_defines.h> __hip_internal::), where the
// 64-bit types are 'long long' / 'unsigned long long' -- NOT glibc's 'long'.
// cudf (cudf/types.hpp) establishes '::int64_t = __hip_internal::int64_t'
// (= long long) at global scope before including this header, so we must use
// 'long long' for the 64-bit aliases here too; pulling in host <stdint.h>
// (which typedefs int64_t = long via <bits/stdint-intn.h>) would clash with
// that, so we deliberately do NOT include it under HIPRTC. The smaller widths
// come from the compiler builtins (__INT*_TYPE__), which agree with HIP for
// 8/16/32-bit. See libhipcxx issue #104 / #304 and commit 49afdcfeb5 for the
// related __hip_internal-based workaround in the atomic code.
#  if defined(_CCCL_COMPILER_HIPRTC)
#    if __has_include(<cstdint>)
// System <cstdint> is available: use it (non-nostdinc++ case)
#      include <cstdint>
#    else
// System <cstdint> NOT available (nostdinc++ case): provide fixed-width types matching HIP
using int8_t   = __INT8_TYPE__;
using int16_t  = __INT16_TYPE__;
using int32_t  = __INT32_TYPE__;
using int64_t  = signed long long; // match __hip_internal::int64_t
using uint8_t  = __UINT8_TYPE__;
using uint16_t = __UINT16_TYPE__;
using uint32_t = __UINT32_TYPE__;
using uint64_t = unsigned long long; // match __hip_internal::uint64_t
#    endif // __has_include(<cstdint>)
#  elif defined(__INT8_TYPE__) && defined(__INT16_TYPE__) && defined(__INT32_TYPE__) \
   && defined(__INT64_TYPE__) && defined(__UINT8_TYPE__) && defined(__UINT16_TYPE__) \
   && defined(__UINT32_TYPE__) && defined(__UINT64_TYPE__)
// NOTE(HIP/AMD): For NVRTC, prefer the compiler-provided __INT*_TYPE__ /
// __UINT*_TYPE__ builtins for the fixed-width integer types (e.g. on
// Linux/glibc x86_64, __INT64_TYPE__ is "long int").
using int8_t   = __INT8_TYPE__;
using int16_t  = __INT16_TYPE__;
using int32_t  = __INT32_TYPE__;
using int64_t  = __INT64_TYPE__;
using uint8_t  = __UINT8_TYPE__;
using uint16_t = __UINT16_TYPE__;
using uint32_t = __UINT32_TYPE__;
using uint64_t = __UINT64_TYPE__;
#  else
using int8_t   = signed char;
using int16_t  = signed short;
using int32_t  = signed int;
using int64_t  = signed long long;
using uint8_t  = unsigned char;
using uint16_t = unsigned short;
using uint32_t = unsigned int;
using uint64_t = unsigned long long;
#  endif

// NOTE(HIP/AMD): Only define _fast and _least types if system <stdint.h>
// hasn't been included (checked via _STDINT_H guard). This allows system
// headers pulled in transitively (e.g., via libstdc++ wrappers) to define
// these types first with their preferred underlying types, avoiding
// "type alias redefinition" conflicts. The compiler's __INT_FAST*_TYPE__
// builtins don't always match what glibc actually uses (e.g., builtin says
// short for int_fast16_t, but glibc uses long), so we can't rely on them.
//
// Also skip defining these types when we included system <cstdint> above
// (HIPRTC with __has_include(<cstdint>) == true), since it will have already
// defined them.
#  if !defined(_STDINT_H) && !(defined(_CCCL_COMPILER_HIPRTC) && __has_include(<cstdint>))
using int_fast8_t = int8_t;
#    if defined(_WIN32) && defined(__HIP_PLATFORM_AMD__)
// NOTE(HIP/AMD): Windows defines int_fast16_t as int, not int16_t (short)
using int_fast16_t = int32_t;
#    else
using int_fast16_t = int16_t;
#    endif
using int_fast32_t = int32_t;
using int_fast64_t = int64_t;
using uint_fast8_t = uint8_t;
#    if defined(_WIN32) && defined(__HIP_PLATFORM_AMD__)
// NOTE(HIP/AMD): Windows defines uint_fast16_t as unsigned int, not uint16_t (unsigned short)
using uint_fast16_t = uint32_t;
#    else
using uint_fast16_t = uint16_t;
#    endif
using uint_fast32_t = uint32_t;
using uint_fast64_t = uint64_t;

using int_least8_t   = int8_t;
using int_least16_t  = int16_t;
using int_least32_t  = int32_t;
using int_least64_t  = int64_t;
using uint_least8_t  = uint8_t;
using uint_least16_t = uint16_t;
using uint_least32_t = uint32_t;
using uint_least64_t = uint64_t;

using intmax_t  = int64_t;
using uintmax_t = uint64_t;
#  endif // !defined(_STDINT_H)

// NOTE(HIP/AMD): Use the compiler-provided pointer-sized integer type
// builtins (matches the host C library, e.g. "long int" on Linux x86_64
// glibc) to avoid type-alias redefinition conflicts with <stdint.h>'s
// intptr_t/uintptr_t when system headers are pulled in transitively.
#  if defined(__INTPTR_TYPE__) && defined(__UINTPTR_TYPE__)
using intptr_t  = __INTPTR_TYPE__;
using uintptr_t = __UINTPTR_TYPE__;
#  else
using intptr_t  = int64_t;
using uintptr_t = uint64_t;
#  endif

#  define INT8_MIN   SCHAR_MIN
