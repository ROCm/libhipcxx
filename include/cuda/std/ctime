// clock

[[nodiscard]] _CCCL_API inline clock_t clock() noexcept
{
  NV_IF_ELSE_TARGET(
    NV_IS_HOST,
    (return ::clock();),
#if _CCCL_HIP_COMPILATION()
    // NOTE(HIP/AMD): use clock64() (per-CU performance counter, raw cycles)
    // rather than wall_clock64() (TSC) so the unit semantics match NVIDIA's
    // get_sreg_clock64() — both return per-multiprocessor cycle counts.
    (return static_cast<clock_t>(clock64());))
#else
    (return static_cast<clock_t>(::cuda::ptx::get_sreg_clock64());))
#endif
}

// difftime

[[nodiscard]] _CCCL_API constexpr double difftime(time_t __end, time_t __start) noexcept
{
  return static_cast<double>(__end - __start);
}

