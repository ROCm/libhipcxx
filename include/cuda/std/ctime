#ifndef _CUDA_STD_CTIME
#define _CUDA_STD_CTIME

#include <cuda/std/detail/__config>

#if defined(_CCCL_IMPLICIT_SYSTEM_HEADER_GCC)
#  pragma GCC system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_CLANG)
#  pragma clang system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_MSVC)
#  pragma system_header
#endif // no system header

#if _CCCL_CUDA_COMPILATION()
#  include <cuda/__ptx/instructions/get_sreg.h>
#endif // _CCCL_CUDA_COMPILATION()

// NOTE(HIP/AMD): _LIBCUDACXX_HIP_TSC_CLOCKRATE /
// _LIBCUDACXX_HIP_TSC_NANOSECONDS_PER_CYCLE used by
// __cccl_time_impl_device() / __cccl_timespec_get_impl_device() are
// supplied transitively by <cuda/std/detail/__config> ->
// <libhipcxx/__amd/hip_tsc_clockrate.h> on HIP.

// NOTE(HIP/AMD): Under hipRTC, including host <time.h> drags in host <stddef.h>
// on the JIT include path, which redefines max_align_t / byte (already provided
// by cuda::std's <cstddef>) and breaks compilation. Treat hipRTC like NVRTC:
// define the C time types we need manually instead of pulling in host <time.h>.
// clock_t (which the NVRTC path gets from the runtime) is declared here for HIP.
#if !_CCCL_COMPILER(NVRTC) && !defined(_CCCL_COMPILER_HIPRTC)
#  include <time.h>
#else
#  define TIME_UTC 1

using time_t = long long int;

struct timespec
{
  ::time_t tv_sec;
  long tv_nsec;
};

#  if defined(_CCCL_COMPILER_HIPRTC)
using clock_t = long long int;
#  endif // _CCCL_COMPILER_HIPRTC
#endif // _CCCL_COMPILER(NVRTC)

#include <cuda/std/__cccl/prologue.h>

_CCCL_BEGIN_NAMESPACE_CUDA_STD

using ::clock_t;
using ::size_t;
using ::time_t;
using ::timespec;

// glibc defines clock and other functions as macros, we need to prevent our symbols being redefined by them

// clock

// We cannot just do `using ::clock` here, for clang-cuda the signature doesn't match.
#if defined(clock)
#  pragma push_macro("clock")
#  undef clock
#  define _LIBCUDACXX_POP_CLOCK_MACRO
#endif // clock
[[nodiscard]] _CCCL_API inline clock_t clock() noexcept
#ifdef _LIBCUDACXX_POP_CLOCK_MACRO
#  pragma pop_macro("clock")
#  undef _LIBCUDACXX_POP_CLOCK_MACRO
#endif // _LIBCUDACXX_POP_CLOCK_MACRO
{
  NV_IF_ELSE_TARGET(
    NV_IS_HOST,
    (return ::clock();),
#if _CCCL_HIP_COMPILATION()
    // NOTE(HIP/AMD): use clock64() (per-CU performance counter, raw cycles)
    // rather than wall_clock64() (TSC) so the unit semantics match NVIDIA's
    // get_sreg_clock64() — both return per-multiprocessor cycle counts.
    (return static_cast<clock_t>(clock64());))
#else
    (return static_cast<clock_t>(::cuda::ptx::get_sreg_clock64());))
#endif
}

// difftime

#if defined(difftime)
#  pragma push_macro("difftime")
#  undef difftime
#  define _LIBCUDACXX_POP_DIFFTIME_MACRO
#endif // difftime
[[nodiscard]] _CCCL_API constexpr double difftime(time_t __end, time_t __start) noexcept
#ifdef _LIBCUDACXX_POP_DIFFTIME_MACRO
#  pragma pop_macro("difftime")
#  undef _LIBCUDACXX_POP_DIFFTIME_MACRO
#endif // _LIBCUDACXX_POP_DIFFTIME_MACRO
{
  return static_cast<double>(__end - __start);
}

// time

#if _CCCL_CUDA_COMPILATION() || _CCCL_HIP_COMPILATION()
[[nodiscard]] _CCCL_HIDE_FROM_ABI _CCCL_DEVICE time_t __cccl_time_impl_device(time_t* __v) noexcept
{
#  if defined(__HIP_DEVICE_COMPILE__)
  // NOTE(HIP/AMD): wall_clock64() returns TSC cycles, not nanoseconds. The TSC
  // clock rate (cycles/sec) is arch-dependent and defined as
  // _LIBCUDACXX_HIP_TSC_CLOCKRATE in <cuda/std/detail/libcxx/include/__config>
  // (e.g. 25 MHz on gfx908/gfx90a, 100 MHz on gfx940/gfx950 and most other
  // architectures). Both that macro and wall_clock64() are only available in
  // the HIP device pass, so this branch is gated on __HIP_DEVICE_COMPILE__.
  const auto __t = static_cast<time_t>(wall_clock64() / _LIBCUDACXX_HIP_TSC_CLOCKRATE);
#  elif _CCCL_HIP_COMPILATION()
  // Host pass on hipcc: this device function body is parsed but never
  // codegen'd, so a stub return suffices.
  const time_t __t = 0;
#  else
  const auto __t = static_cast<time_t>(::cuda::ptx::get_sreg_globaltimer() / 1'000'000'000);
#  endif
  if (__v != nullptr)
  {
    *__v = __t;
  }
  return __t;
}
#endif // _CCCL_CUDA_COMPILATION() || _CCCL_HIP_COMPILATION()

#if defined(time)
#  pragma push_macro("time")
#  undef time
#  define _LIBCUDACXX_POP_TIME_MACRO
#endif // time
_CCCL_API inline time_t time(time_t* __v) noexcept
#ifdef _LIBCUDACXX_POP_TIME_MACRO
#  pragma pop_macro("time")
#  undef _LIBCUDACXX_POP_TIME_MACRO
#endif // _LIBCUDACXX_POP_TIME_MACRO
{
  NV_IF_ELSE_TARGET(NV_IS_HOST, (return ::time(__v);), (return ::cuda::std::__cccl_time_impl_device(__v);))
}

#if !defined(__ANDROID_API__) || __ANDROID_API__ >= 29

// timespec_get

#  if _CCCL_CUDA_COMPILATION() || _CCCL_HIP_COMPILATION()
[[nodiscard]] _CCCL_HIDE_FROM_ABI _CCCL_DEVICE int __cccl_timespec_get_impl_device(timespec* __ts, int __base) noexcept
{
  if (__base != TIME_UTC)
  {
    return 0;
  }
#    if defined(__HIP_DEVICE_COMPILE__)
  // NOTE(HIP/AMD): wall_clock64() returns TSC cycles, not nanoseconds.
  // Convert with the arch-dependent TSC rate (see __cccl_time_impl_device):
  //   tv_sec  = cycles / CLOCKRATE
  //   tv_nsec = (cycles % CLOCKRATE) * NANOSECONDS_PER_CYCLE
  // Both _LIBCUDACXX_HIP_TSC_CLOCKRATE and
  // _LIBCUDACXX_HIP_TSC_NANOSECONDS_PER_CYCLE are only defined in the HIP
  // device pass.
  const auto __t = wall_clock64();
  __ts->tv_sec   = static_cast<time_t>(__t / _LIBCUDACXX_HIP_TSC_CLOCKRATE);
  __ts->tv_nsec  = static_cast<long>((__t % _LIBCUDACXX_HIP_TSC_CLOCKRATE)
                                     * _LIBCUDACXX_HIP_TSC_NANOSECONDS_PER_CYCLE);
#    elif _CCCL_HIP_COMPILATION()
  // Host pass on hipcc: this device function body is parsed but never
  // codegen'd, so a stub suffices.
  __ts->tv_sec  = 0;
  __ts->tv_nsec = 0;
#    else
  const auto __t = ::cuda::ptx::get_sreg_globaltimer();
  __ts->tv_sec   = static_cast<time_t>(__t / 1'000'000'000);
  __ts->tv_nsec  = static_cast<long>(__t % 1'000'000'000);
#    endif
  return __base;
}
#  endif // _CCCL_CUDA_COMPILATION() || _CCCL_HIP_COMPILATION()

#  if defined(timespec_get)
#    pragma push_macro("timespec_get")
#    undef timespec_get
#    define _LIBCUDACXX_POP_TIMESPEC_GET_MACRO
#  endif // timespec_get
template <int = 0>
[[nodiscard]] _CCCL_API inline int timespec_get(timespec* __ts, int __base) noexcept
#  ifdef _LIBCUDACXX_POP_TIMESPEC_GET_MACRO
#    pragma pop_macro("timespec_get")
#    undef _LIBCUDACXX_POP_TIMESPEC_GET_MACRO
#  endif // _LIBCUDACXX_POP_TIMESPEC_GET_MACRO
{
  NV_IF_ELSE_TARGET(NV_IS_HOST,
                    (return ::timespec_get(__ts, __base);),
                    (return ::cuda::std::__cccl_timespec_get_impl_device(__ts, __base);))
}

#endif // !defined(__ANDROID_API__) || __ANDROID_API__ >= 29

_CCCL_END_NAMESPACE_CUDA_STD

#include <cuda/std/__cccl/epilogue.h>

#endif // _CUDA_STD_CTIME
