// NOTE(HIP/AMD): on CUDA the cuda::execution policy objects (cuda::execution::
// __cub_par_unseq, .with_stream/.with_memory_resource) are pulled in by the CUB
// PSTL backend headers (gated on _CCCL_HAS_BACKEND_CUDA()). That backend is not
// ported to HIP yet, but the policy objects themselves are CUB-free, so pull the
// policy header directly on HIP to expose the cuda::execution surface.
#if _CCCL_HIP_COMPILATION()
#  include <cuda/__execution/policy.h>
#endif // _CCCL_HIP_COMPILATION()

