#ifndef _LIBCUDACXX_LEGACY_DETAIL_LIBCXX_INCLUDE_CONFIG
#define _LIBCUDACXX_LEGACY_DETAIL_LIBCXX_INCLUDE_CONFIG

#include <cuda/std/detail/__config>

#if defined(_CCCL_IMPLICIT_SYSTEM_HEADER_GCC)
#  pragma GCC system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_CLANG)
#  pragma clang system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_MSVC)
#  pragma system_header
#endif // no system header

#ifdef LIBHIPCXX_NO_LEGACY_COMPAT
#  error "<cuda/std/detail/libcxx/include/__config> is a legacy header, use <cuda/std/detail/__config>."
#endif // LIBHIPCXX_NO_LEGACY_COMPAT

#include <cuda/std/__utility/ctad_support.h>

#define _LIBCUDACXX_CTAD_SUPPORTED_FOR_TYPE(_ClassName) _CCCL_CTAD_SUPPORTED_FOR_TYPE(_ClassName)
#if _LIBHIPCXX_LEGACY_DEPRECATE_MACROS()
#  pragma clang deprecated(_LIBCUDACXX_CTAD_SUPPORTED_FOR_TYPE, _LIBHIPCXX_LEGACY_COMPAT_MSG)
#endif // _LIBHIPCXX_LEGACY_DEPRECATE_MACROS()

#endif // _LIBCUDACXX_LEGACY_DETAIL_LIBCXX_INCLUDE_CONFIG
