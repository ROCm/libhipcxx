// NOTE(HIP/AMD): forwarding header for consumers of libhipcxx <= 3.1, which
// include this removed internal path directly and use __throw_runtime_error.
// See <libhipcxx/__amd/legacy_compat.h>.

#ifndef _LIBCUDACXX_LEGACY_DETAIL_LIBCXX_INCLUDE_STDEXCEPT
#define _LIBCUDACXX_LEGACY_DETAIL_LIBCXX_INCLUDE_STDEXCEPT

#include <cuda/std/detail/__config>

#if defined(_CCCL_IMPLICIT_SYSTEM_HEADER_GCC)
#  pragma GCC system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_CLANG)
#  pragma clang system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_MSVC)
#  pragma system_header
#endif // no system header

#ifdef LIBHIPCXX_NO_LEGACY_COMPAT
#  error "<cuda/std/detail/libcxx/include/stdexcept> is a legacy header."
#endif // LIBHIPCXX_NO_LEGACY_COMPAT

#include <cuda/std/__exception/terminate.h>

#include <nv/target>

#if _CCCL_HAS_EXCEPTIONS()
#  include <stdexcept>
#endif // _CCCL_HAS_EXCEPTIONS()

#include <cuda/std/__cccl/prologue.h>

_CCCL_BEGIN_NAMESPACE_CUDA_STD

[[noreturn]] _LIBHIPCXX_LEGACY_DEPRECATED _CCCL_API inline void __throw_runtime_error(const char* __msg)
{
#if _CCCL_HAS_EXCEPTIONS()
  NV_IF_ELSE_TARGET(NV_IS_HOST, (throw ::std::runtime_error(__msg);), ((void) __msg; ::cuda::std::terminate();))
#else // ^^^ _CCCL_HAS_EXCEPTIONS() ^^^ / vvv !_CCCL_HAS_EXCEPTIONS() vvv
  (void) __msg;
  ::cuda::std::terminate();
#endif // !_CCCL_HAS_EXCEPTIONS()
}

_CCCL_END_NAMESPACE_CUDA_STD

#include <cuda/std/__cccl/epilogue.h>

#endif // _LIBCUDACXX_LEGACY_DETAIL_LIBCXX_INCLUDE_STDEXCEPT
