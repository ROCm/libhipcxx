#ifndef _CUDA_STD_INITIALIZER_LIST
#define _CUDA_STD_INITIALIZER_LIST

#include <cuda/std/detail/__config>

#if defined(_CCCL_IMPLICIT_SYSTEM_HEADER_GCC)
#  pragma GCC system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_CLANG)
#  pragma clang system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_MSVC)
#  pragma system_header
#endif // no system header

// NOTE(HIP/AMD): Under HIPRTC with -nostdinc++ (e.g., cudf JIT), the host C++
// standard library is not on the include path, so <initializer_list> is not found
// and `::std::initializer_list` would be undefined. However, when HIPRTC is used
// WITHOUT -nostdinc++ (e.g., lit tests), the system <initializer_list> IS available
// and should be used to avoid redefinition errors.
//
// Strategy: Check if <initializer_list> is available. If yes, use it; if no (nostdinc++),
// provide our own minimal implementation. `std::initializer_list` is a compiler-magic
// type that clang recognizes with {const T*, size} layout in namespace std.
#if defined(_CCCL_COMPILER_HIPRTC)
#  if __has_include(<initializer_list>)
// System <initializer_list> is available: use it (non-nostdinc++ case)
#    include <initializer_list>
#  else
// System <initializer_list> NOT available (nostdinc++ case): provide minimal implementation
namespace std
{
template <class _Ep>
class initializer_list
{
  const _Ep* __begin_;
  decltype(sizeof(int)) __size_;

  _CCCL_API constexpr initializer_list(const _Ep* __b, decltype(sizeof(int)) __s) noexcept
      : __begin_(__b)
      , __size_(__s)
  {}

public:
  using value_type      = _Ep;
  using reference       = const _Ep&;
  using const_reference = const _Ep&;
  using size_type       = decltype(sizeof(int));
  using iterator        = const _Ep*;
  using const_iterator  = const _Ep*;

  _CCCL_API constexpr initializer_list() noexcept
      : __begin_(nullptr)
      , __size_(0)
  {}

  [[nodiscard]] _CCCL_API constexpr size_type size() const noexcept
  {
    return __size_;
  }
  [[nodiscard]] _CCCL_API constexpr const _Ep* begin() const noexcept
  {
    return __begin_;
  }
  [[nodiscard]] _CCCL_API constexpr const _Ep* end() const noexcept
  {
    return __begin_ + __size_;
  }
};
} // namespace std
#  endif // __has_include(<initializer_list>)
#elif !_CCCL_COMPILER(NVRTC)
// On the host (and hipcc host pass) include the system <initializer_list> so we
// share the same definition as system headers.
#  include <initializer_list>
#else // ^^^ !_CCCL_COMPILER(NVRTC) ^^^ / vvv _CCCL_COMPILER(NVRTC) vvv
#  if !defined(__NV_BUILTIN_INITIALIZER_LIST)
#    error "libcu++ requires -builtin-initializer-list=true when compiling with NVRTC"
#  endif // !__NV_BUILTIN_INITIALIZER_LIST
#endif // ^^^ _CCCL_COMPILER(NVRTC) ^^^

#include <cuda/std/__cccl/prologue.h>

_CCCL_BEGIN_NAMESPACE_CUDA_STD

using ::std::initializer_list;

template <class _Tp>
inline constexpr bool __is_cuda_std_initializer_list = false;

template <class _Ep>
inline constexpr bool __is_cuda_std_initializer_list<initializer_list<_Ep>> = true;

_CCCL_END_NAMESPACE_CUDA_STD

#include <cuda/std/__cccl/epilogue.h>

#endif // _CUDA_STD_INITIALIZER_LIST
